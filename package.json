      "fflate@>=0.7.0 <0.7.5": "^0.7.5",
      "follow-redirects@<1.16.1": "^1.16.1",
      "form-data@>=4.0.0 <4.0.6": "^4.0.6",
      "http-proxy-middleware@>=0.16.0 <2.0.10": "^2.0.10",
      "image-size@>=2.0.0 <2.0.3": "^2.0.3",
      "immutable@>=5.0.0-beta.1 <5.1.8": "^5.1.8",
      "joi@<17.13.8": "^17.13.8",
      "launch-editor@<=2.14.1": "^2.14.2",
      "mermaid@>=11.0.0-alpha.1 <11.16.1": "^11.16.1",
      "nanoid@<3.3.18": "^3.3.18",
      "postcss-selector-parser@>=6.1.0 <6.1.5": "^6.1.5",
      "postcss-selector-parser@>=7.1.0 <7.1.3": "^7.1.3",
      "postcss@<=8.5.22": "^8.5.23",
      "proxy-addr@<2.0.8": "^2.0.8",
      "qs@>=2.2.5 <6.16.0": "^6.16.0",
      "serialize-javascript@>=5.0.0 <7.1.3": "^7.1.3",
      "shell-quote@<1.11.0": "^1.11.0",
      "source-map-js@>=1.0.0 <1.2.2": "^1.2.2",
      "svgo@>=3.0.0 <3.3.5": "^3.3.5",
      "tinypool@<2.1.2": "^2.1.2",
      "uuid@<11.1.1": "^11.1.1",
      "webpack-dev-middleware@>=7.0.0 <7.4.6": "^7.4.6",
      "webpack-dev-server@<=5.2.5": "^5.2.6",
      "websocket-driver@<0.7.5": "^0.7.5",
      "ws@>=7.0.0 <7.5.11": "^7.5.11"
    },
    "onlyBuiltDependencies": [
